# Copy this file to .env for local development. Never commit real secrets.
# All infrastructure here is local except Auth0 development auth and Stripe test mode.

# Application
APP_ENV=development
FRONTEND_URL=http://localhost:5173
FASTAPI_URL=http://localhost:8000
DJANGO_URL=http://localhost:8001
AUTH_MODE=local
VITE_AUTH_MODE=local
VITE_API_URL=http://localhost:8000/api/v1

# MySQL 8
MYSQL_DATABASE=smart_ecommerce
MYSQL_USER=smart_ecommerce
MYSQL_PASSWORD=replace_me
MYSQL_ROOT_PASSWORD=replace_me
MYSQL_HOST_PORT=3307
DATABASE_URL=mysql+pymysql://smart_ecommerce:replace_me@mysql:3306/smart_ecommerce
DJANGO_DATABASE_URL=mysql://smart_ecommerce:replace_me@mysql:3306/smart_ecommerce
DB_HOST=mysql
DB_PORT=3306
DB_USER=smart_ecommerce
DB_PASSWORD=replace_me
DB_NAME=smart_ecommerce

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Auth0 - values created in the Auth0 dashboard
VITE_AUTH0_DOMAIN=your-tenant.region.auth0.com
VITE_AUTH0_CLIENT_ID=replace_me
VITE_AUTH0_AUDIENCE=https://api.smart-ecommerce.local
AUTH0_DOMAIN=your-tenant.region.auth0.com
AUTH0_AUDIENCE=https://api.smart-ecommerce.local
AUTH0_ALGORITHMS=RS256
AUTH0_MANAGEMENT_CLIENT_ID=replace_me
AUTH0_MANAGEMENT_CLIENT_SECRET=replace_me
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Stripe - start with test-mode values only
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=inr
STRIPE_DEMO_MODE=true

# Authenticated SMTP provider (for example Gmail SMTP)
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=replace_me
SMTP_TIMEOUT_SECONDS=15
EMAIL_FROM_ADDRESS=sender@example.com
EMAIL_FROM_NAME=Smart Ecommerce

# Django
DJANGO_SECRET_KEY=replace_with_a_long_random_value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local product image and report storage
MEDIA_ROOT=/app/media
REPORT_EXPORT_ROOT=/app/exports
